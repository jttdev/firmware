# syntax=docker/dockerfile:1
FROM python:3.13-slim-bookworm

# PlatformIO + host-tool build deps
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    git \
    bash \
    ca-certificates \
    build-essential \
 && rm -rf /var/lib/apt/lists/*

ARG PYPI_INDEX=https://pypi.org/simple/

# PlatformIO + workflow deps
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock /tmp/pydeps/
WORKDIR /tmp/pydeps
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy
ENV UV_INDEX_URL=${PYPI_INDEX}
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev
ENV PATH="/opt/venv/bin:$PATH"
ENV VIRTUAL_ENV="/opt/venv"

WORKDIR /work

# Keep PlatformIO home on a volume by default
ENV PLATFORMIO_CORE_DIR=/root/.platformio
